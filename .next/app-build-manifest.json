{
  "pages": {
    "/[locale]/layout": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/[locale]/layout.css",
      "static/chunks/app/[locale]/layout.js"
    ],
    "/[locale]/error": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/[locale]/error.css",
      "static/chunks/app/[locale]/error.js"
    ],
    "/[locale]/not-found": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/[locale]/not-found.css",
      "static/chunks/app/[locale]/not-found.js"
    ],
    "/[locale]/(site)/layout": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/[locale]/(site)/layout.css",
      "static/chunks/app/[locale]/(site)/layout.js"
    ],
    "/[locale]/(site)/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/[locale]/(site)/page.css",
      "static/chunks/app/[locale]/(site)/page.js"
    ],
    "/[locale]/[...slug]/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/[locale]/[...slug]/page.js"
    ]
  }
}
